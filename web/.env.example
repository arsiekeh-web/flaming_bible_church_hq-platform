# Copy this file to .env.local and fill in real values.
# Find both in your Supabase project: Settings → API

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=paste-your-publishable-key-here

# Never commit .env.local, and never put the service_role key in
# anything prefixed NEXT_PUBLIC_ — that key bypasses RLS entirely.

# Google Analytics 4 Measurement ID (e.g. G-XXXXXXXXXX).
# Find it in Google Analytics: Admin → Data Streams → your web stream.
# Leave blank/unset to disable analytics entirely.
NEXT_PUBLIC_GA_ID=
